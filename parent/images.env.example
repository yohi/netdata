# Pin the multi-architecture Netdata stable manifest by digest.
NETDATA_IMAGE=netdata/netdata@sha256:21970e176031fdb9469503534d01b4dc2fe2c36d369a5a4be74b6ec5c8b7a5c3

# Pin cloudflared to the version verified by the host preflight.
CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:b269e8abd07a5bf6f3f4be65d5050b2174eca89c56a0241a8ff32a16aec454e4

# Replace with ./secrets/cloudflared-token after provisioning the real token.
CLOUDFLARED_TOKEN_FILE=./secrets/cloudflared-token.example
